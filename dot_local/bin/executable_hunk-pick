#!/usr/bin/env bash
# Pick a diff range with fzf and open it in hunk. Quitting hunk returns to the
# picker; leave for good with Esc, q or Left arrow there.
set -euo pipefail

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "hunk-pick: not inside a git repository" >&2
  exit 1
fi

base="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)"

labels=(
  "Uncommitted changes (unstaged + staged)"
  " ├─ Unstaged changes"
  " └─ Staged changes"
  "Branch changes (${base}...HEAD)"
  " ├─ Branch changes + uncommitted changes (${base})"
)

max_commits=50

# Commits on the current branch, newest first. Falls back to recent history
# when the branch has no commits ahead of the base (e.g. sitting on main).
commits=()
while IFS= read -r line; do
  commits+=("$line")
done < <(git log --format='%h %s' -n "${max_commits}" "${base}..HEAD" 2>/dev/null || true)

if [ "${#commits[@]}" -eq 0 ]; then
  while IFS= read -r line; do
    commits+=("$line")
  done < <(git log --format='%h %s' -n "${max_commits}" HEAD 2>/dev/null || true)
fi

# Render the commits as the remaining children of "Branch changes".
commit_labels=()
last=$(( ${#commits[@]} - 1 ))
for i in "${!commits[@]}"; do
  if [ "$i" -eq "$last" ]; then
    commit_labels+=(" └─ ${commits[$i]}")
  else
    commit_labels+=(" ├─ ${commits[$i]}")
  fi
done

if [ "${#commits[@]}" -eq 0 ]; then
  labels[4]=" └─ Branch changes + uncommitted changes (${base})"
fi

while true; do
  choice="$(printf '%s\n' "${labels[@]}" ${commit_labels[@]+"${commit_labels[@]}"} | fzf --prompt='hunk diff > ' --height=100% --reverse --no-sort --bind='q:abort,left:abort')" || exit 0

  diff_args=()
  case "$choice" in
    "${labels[0]}") diff_args=(HEAD) ;;
    "${labels[1]}") diff_args=() ;;
    "${labels[2]}") diff_args=(--staged) ;;
    "${labels[3]}") diff_args=("${base}...HEAD") ;;
    "${labels[4]}") diff_args=("${base}") ;;
    "") exit 0 ;;
    *)
      commit_line="${choice#*─ }"
      sha="${commit_line%% *}"
      if ! git rev-parse --verify --quiet "${sha}^{commit}" >/dev/null; then
        continue
      fi
      if git rev-parse --verify --quiet "${sha}^" >/dev/null; then
        diff_args=("${sha}^..${sha}")
      else
        diff_args=("$(git hash-object -t tree /dev/null)..${sha}")
      fi
      ;;
  esac

  status=0
  hunk diff ${diff_args[@]+"${diff_args[@]}"} || status=$?
  if [ "${status}" -ne 0 ]; then
    echo "hunk-pick: hunk exited with status ${status}" >&2
    exit "${status}"
  fi
done
