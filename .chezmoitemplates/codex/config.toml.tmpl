approvals_reviewer = "auto_review"
Process_narration = false
sandbox_mode = "workspace-write"

[features]
goals = true
daemon_auto_start = false

[plugins."security-guidance@claude-plugins-official"]
enabled = false

[sandbox_workspace_write]
network_access = true

[tui]
auto_recap = false
status_line = ["model-with-reasoning", "current-dir", "git-branch", "pull-request-number", "branch-changes", "approval-mode", "context-used", "five-hour-limit", "weekly-limit"]
status_line_use_colors = true

[tui.keymap.chat]
edit_queued_message = "alt-q"
