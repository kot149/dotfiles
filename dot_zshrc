# Aliases
unalias rm 2>/dev/null
rm() {
  local -a args
  local arg filtered

  for arg in "$@"; do
    case "$arg" in
      --recursive)
        continue
        ;;
      -[!-]*)
        filtered="-${arg[2,-1]//[rR]/}"
        if [[ "$filtered" != "-" ]]; then
          args+=("$filtered")
        fi
        ;;
      -r|-R)
        continue
        ;;
      *)
        args+=("$arg")
        ;;
    esac
  done

  command rip "${args[@]}"
}

