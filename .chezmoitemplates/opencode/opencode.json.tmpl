{{- /* opencode matches each parsed sub-command of a compound command against
       these patterns, in file order, last match wins. Allows are emitted first
       and denies last so a deny always overrides the allow it narrows.
       A pattern ending in " *" is rewritten to "( .*)?" by opencode, so it
       already covers the bare command. */ -}}
{{- $perms := includeTemplate "agents/shell-permissions.tmpl" . | fromJson -}}
{{- $allowPatterns := concat $perms.allow $perms.allowWrite -}}
{{- $denyPatterns := $perms.deny -}}
{{- $seen := dict "*" true -}}
{{- range $denyPatterns -}}
  {{- $_ := set $seen . true -}}
{{- end -}}
{{- $bashLines := list "\"*\": \"ask\"" -}}
{{- range $allowPatterns -}}
  {{- if not (hasKey $seen .) -}}
    {{- $_ := set $seen . true -}}
    {{- $bashLines = append $bashLines (printf "%s: \"allow\"" (toJson .)) -}}
  {{- end -}}
{{- end -}}
{{- $emitted := dict -}}
{{- range $denyPatterns -}}
  {{- if not (hasKey $emitted .) -}}
    {{- $_ := set $emitted . true -}}
    {{- $bashLines = append $bashLines (printf "%s: \"deny\"" (toJson .)) -}}
  {{- end -}}
{{- end -}}
{{- $externalDirs := list "~/.cargo/*" "~/.rustup/*" "~/.portless/*" "~/.local/share/opencode/*" -}}
{{- if eq .chezmoi.os "windows" -}}
  {{- $externalDirs = concat $externalDirs (list "~/AppData/Local/Temp/*" "~/AppData/Local/rtk/*") -}}
{{- else -}}
  {{- $externalDirs = concat $externalDirs (list "/tmp/*") -}}
{{- end -}}
{{- $dirLines := list -}}
{{- range $externalDirs -}}
  {{- $dirLines = append $dirLines (printf "%s: \"allow\"" (toJson .)) -}}
{{- end -}}
{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "permission": {
    "bash": {
      {{ join ",\n      " $bashLines }}
    },
    "external_directory": {
      "*": "ask",
      {{ join ",\n      " $dirLines }}
    },
    "edit": "allow",
    "websearch": "allow",
    "webfetch": "ask"
  }
}
