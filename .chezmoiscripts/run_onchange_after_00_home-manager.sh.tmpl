{{- if ne .chezmoi.os "windows" -}}
#!/bin/bash

{{- $src := printf "%s/" .chezmoi.sourceDir }}
{{- range sortAlpha (glob (joinPath .chezmoi.sourceDir "private_dot_config/home-manager/**")) }}
{{- $name := base . }}
{{- if not (or (stat .).isDir (hasPrefix "." $name) (hasSuffix "~" $name) (hasSuffix ".swp" $name)) }}
# {{ trimPrefix $src . }} hash: {{ include . | sha256sum }}
{{- end }}
{{- end }}
{{- $wsl := and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) }}
# data: username={{ .chezmoi.username }} homeDir={{ .chezmoi.homeDir }} arch={{ .chezmoi.arch }} wsl={{ $wsl }} linuxGui={{ if hasKey . "linuxGui" }}{{ .linuxGui }}{{ else }}unset{{ end }} nix_substituters={{ toJson .nix_substituters | sha256sum }}
{{- $localPath := printf "%s/.config/home-manager/local.nix" .chezmoi.homeDir -}}
{{- $localStat := stat $localPath -}}
{{- if $localStat }}
# local.nix stat: {{ $localStat }}
{{- end }}

echo "Applying Home Manager configuration..."
# Substituters are declared in .chezmoidata.toml and rendered into the
# user nix.conf by Home Manager itself. On the very first switch (and on
# any switch that adds a new cache) the current nix.conf does not yet
# contain them, so nix would build from source instead of pulling from
# the caches this switch is about to install. Inject them via NIX_CONFIG
# so the switch bootstraps its own caches.
export NIX_CONFIG="extra-substituters = {{ range $i, $s := .nix_substituters }}{{ if $i }} {{ end }}{{ $s.url }}{{ end }}
extra-trusted-public-keys = {{ range $i, $s := .nix_substituters }}{{ if $i }} {{ end }}{{ $s.key }}{{ end }}"

# Use the generic 'default' configuration
if command -v nh >/dev/null 2>&1; then
  nh home switch "$HOME/.config/home-manager" -c default
else
  nix --extra-experimental-features "flakes nix-command" run home-manager/master -- switch --flake "$HOME/.config/home-manager#default"
fi
{{- end -}}
