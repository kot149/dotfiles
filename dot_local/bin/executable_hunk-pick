#!/usr/bin/env bash
# Pick a diff range with fzf and open it in hunk. Quitting hunk returns to the
# picker; leave for good with Esc, q or Left arrow there.
set -euo pipefail

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "hunk-pick: not inside a git repository" >&2
  exit 1
fi

base="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)"

labels=(
  "Uncommitted changes (unstaged + staged)"
  " ├─ Unstaged changes"
  " └─ Staged changes"
  "Branch changes (${base}...HEAD)"
  " ├─ Branch changes + uncommitted changes (${base})"
)

max_commits=50

# Commits on the current branch, newest first. Falls back to recent history
# when the branch has no commits ahead of the base (e.g. sitting on main).
commits=()
while IFS= read -r line; do
  commits+=("$line")
done < <(git log --format='%h %s' -n "${max_commits}" "${base}..HEAD" 2>/dev/null || true)

if [ "${#commits[@]}" -eq 0 ]; then
  while IFS= read -r line; do
    commits+=("$line")
  done < <(git log --format='%h %s' -n "${max_commits}" HEAD 2>/dev/null || true)
fi

# Render the commits as the remaining children of "Branch changes".
commit_labels=()
last=$(( ${#commits[@]} - 1 ))
for i in "${!commits[@]}"; do
  if [ "$i" -eq "$last" ]; then
    commit_labels+=(" └─ ${commits[$i]}")
  else
    commit_labels+=(" ├─ ${commits[$i]}")
  fi
done

if [ "${#commits[@]}" -eq 0 ]; then
  labels[4]=" └─ Branch changes + uncommitted changes (${base})"
fi

items=("${labels[@]}" ${commit_labels[@]+"${commit_labels[@]}"})

# The entries fzf shows for a query. --no-sort keeps them in input order, which
# is what the interactive picker displays too.
filtered_items() {
  if [ -z "$1" ]; then
    printf '%s\n' "${items[@]}"
  else
    printf '%s\n' "${items[@]}" | fzf --filter="$1" --no-sort || true
  fi
}

# 1-based position of an entry among the filtered ones, so the cursor can be
# restored when the picker reopens.
cursor_position() {
  local target="$1" query="$2" position=1 line
  while IFS= read -r line; do
    if [ "${line}" = "${target}" ]; then
      printf '%s' "${position}"
      return
    fi
    position=$(( position + 1 ))
  done < <(filtered_items "${query}")
  printf '1'
}

query=""
position=1

while true; do
  # --print-query puts the query on the first line, the selection on the second.
  # pos() needs the result event because filtering is not done yet on start.
  fzf_output="$(printf '%s\n' "${items[@]}" | fzf \
    --prompt='hunk diff > ' --height=100% --reverse --no-sort --sync \
    --print-query --query="${query}" \
    --bind='q:abort,left:abort' \
    --bind="result:pos(${position})+unbind(result)")" || exit 0

  mapfile -t fzf_lines <<<"${fzf_output}"
  query="${fzf_lines[0]-}"
  choice="${fzf_lines[1]-}"
  position="$(cursor_position "${choice}" "${query}")"

  diff_args=()
  case "$choice" in
    "${labels[0]}") diff_args=(HEAD) ;;
    "${labels[1]}") diff_args=() ;;
    "${labels[2]}") diff_args=(--staged) ;;
    "${labels[3]}") diff_args=("${base}...HEAD") ;;
    "${labels[4]}") diff_args=("${base}") ;;
    "") exit 0 ;;
    *)
      commit_line="${choice#*─ }"
      sha="${commit_line%% *}"
      if ! git rev-parse --verify --quiet "${sha}^{commit}" >/dev/null; then
        continue
      fi
      if git rev-parse --verify --quiet "${sha}^" >/dev/null; then
        diff_args=("${sha}^..${sha}")
      else
        diff_args=("$(git hash-object -t tree /dev/null)..${sha}")
      fi
      ;;
  esac

  status=0
  hunk diff ${diff_args[@]+"${diff_args[@]}"} || status=$?
  if [ "${status}" -ne 0 ]; then
    echo "hunk-pick: hunk exited with status ${status}" >&2
    exit "${status}"
  fi
done
