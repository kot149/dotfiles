# Shared cli-proxy-api setup for claudex: a single proxy serves Codex OAuth
# models (luna/sol/astra). Port is 8319 on zsh (8317 is held outside WSL on
# this machine; plain Linux/macOS work the same) and 8317 on PowerShell
# (Windows). The runtime config only rewrites the port, keeping the managed
# config.yaml secret-free.
_cli_proxy_merged_config() {
  local port=8319
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/cli-proxy-api"
  local base_config="${XDG_CONFIG_HOME:-$HOME/.config}/cli-proxy-api/config.yaml"
  local merged_config="$cache_dir/claude-config.yaml"
  local merged_new
  if [[ -f "$base_config" ]]; then
    merged_new="$(sed "s/^port:[[:space:]]*.*/port: $port/" "$base_config")"
  else
    merged_new="$(printf 'host: "127.0.0.1"\nport: %s\napi-keys:\n  - "sk-local-cliproxy"' "$port")"
  fi
  mkdir -p "$cache_dir"
  if [[ ! -f "$merged_config" ]] || [[ "$merged_new" != "$(cat "$merged_config")" ]]; then
    (umask 077; printf '%s\n' "$merged_new" >"$merged_config")
  fi
  printf '%s' "$merged_config"
}

_cli_proxy_ensure() {
  local port=8319
  local merged_config="$(_cli_proxy_merged_config)"
  if ! curl --silent --fail --max-time 1 "http://127.0.0.1:$port/v1/models" \
      -H 'Authorization: Bearer sk-local-cliproxy' >/dev/null 2>&1; then
    local proxy_bin
    proxy_bin=$(command -v cli-proxy-api 2>/dev/null) || {
      echo "CLIProxyAPI is not installed" >&2
      return 1
    }
    "$proxy_bin" -config "$merged_config" \
      >"${XDG_CACHE_HOME:-$HOME/.cache}/cli-proxy-api/server.log" 2>&1 &!
    sleep 1
    if ! curl --silent --fail --max-time 2 "http://127.0.0.1:$port/v1/models" \
        -H 'Authorization: Bearer sk-local-cliproxy' >/dev/null 2>&1; then
      echo "claude proxy failed to start on 127.0.0.1:$port (see server.log)" >&2
      return 1
    fi
  fi
}

_claude_gpt() {
  local model="$1"
  local effort="$2"
  local subagent_model="$model"
  local subagent_effort="$effort"
  if (( $# >= 4 )); then
    subagent_model="$3"
    subagent_effort="$4"
    shift 4
  elif (( $# >= 3 )); then
    subagent_model="$3"
    shift 3
  else
    shift 2
  fi

  local agents_json
  printf -v agents_json '{"luna":{"description":"General-purpose agent using the configured Luna model","prompt":"Complete the delegated task accurately and concisely.","model":"%s(%s)"}}' \
    "$subagent_model" "$subagent_effort"

  _cli_proxy_ensure || return 1

  # The auto mode classifier runs on the Sonnet alias, so it stays on the
  # subagent model. The proxy cannot do Anthropic's server-side checks.
  ANTHROPIC_BASE_URL=http://127.0.0.1:8319 \
  ANTHROPIC_AUTH_TOKEN=sk-local-cliproxy \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="${subagent_model}(${subagent_effort})" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="${subagent_model}(${subagent_effort})" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="${subagent_model}(${subagent_effort})" \
  CLAUDE_CODE_SUBAGENT_MODEL="${subagent_model}(${subagent_effort})" \
  CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1 \
  CLAUDE_CODE_ALWAYS_ENABLE_EFFORT=1 \
  CLAUDE_CODE_AUTO_MODE_SERVER=0 \
  CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY=3 \
  CLAUDE_CODE_MAX_CONTEXT_TOKENS=1050000 \
  ENABLE_TOOL_SEARCH=false \
    claude --model "${model}(${effort})" --effort "$effort" \
      --agents "$agents_json" \
      --append-system-prompt 'Use the luna agent type for general-purpose delegation. Use another agent type only when its specialized capabilities are required.' \
      "$@"
}

claudex() {
  local variant="luna"
  if (( $# > 0 )); then
    variant="$1"
    shift
  fi
  if [[ "$variant" == -* ]]; then
    set -- "$variant" "$@"
    variant="luna"
  fi
  case "$variant" in
    luna) _claude_gpt gpt-6-luna xhigh "$@" ;;
    sol) _claude_gpt gpt-6-sol medium gpt-6-luna xhigh "$@" ;;
    astra) _claude_gpt gpt-6-astra low gpt-6-luna xhigh "$@" ;;
    *) echo "claudex: unknown variant '$variant' (expected luna|sol|astra)" >&2; return 1 ;;
  esac
}

# .git/info/exclude にローカル限定の無視パターンを追加する
local-ignore() {
  if [ $# -eq 0 ]; then
    echo "Usage: local-ignore <pattern>..." >&2
    return 1
  fi

  local git_dir
  git_dir=$(git rev-parse --git-dir 2>/dev/null) || {
    echo "fatal: Not a git repository." >&2
    return 1
  }

  local exclude_file="$git_dir/info/exclude"
  mkdir -p "$git_dir/info"

  local pattern
  for pattern in "$@"; do
    if grep -qxF -- "$pattern" "$exclude_file" 2>/dev/null; then
      echo "Already ignored: $pattern"
    else
      echo "$pattern" >> "$exclude_file"
      echo "Added to local ignore: $pattern"
    fi
  done
}
