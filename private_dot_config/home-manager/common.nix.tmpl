{ config, lib, pkgs, llmAgents, ... }:

let
  basePackages = (with pkgs; [
    # nix
    nix

    # dotfiles
    chezmoi

    # git
    git
    gh
    lazygit
    tuicr
    pre-commit
    act
    pinact
    actionlint
    git-filter-repo

    # shell
    zsh
    oh-my-zsh
    sheldon
    starship
    direnv
    nix-direnv
    tree
    msedit
    ripgrep
    zoxide
    fzf
    fd
    bat
    moor
    eza
    superfile
    fresh-editor
    rip2
    jq
    yq
    yazi
    zellij

    # programming
    cmake
    nodejs_24
    pnpm
    bun
    ni

    uv
    pyenv
    pipenv

    go

    rustup
    cargo-binstall
    cargo-make
    cargo-nextest

    # db
    mysql84

    # editor
    neovim
    (callPackage ./pkgs/tode.nix { })
    tree-sitter
    lua-language-server
    nil
    stylua

    # ai (from llm-agents.nix, prebuilt in cache.numtide.com)
    llmAgents.agent-browser
    llmAgents.claude-code
    llmAgents.codex
    llmAgents.dsh
    llmAgents.herdr
    llmAgents.hunk
    llmAgents.ax
    (pkgs.runCommand "opencode-${llmAgents.opencode2.version}" { } ''
      mkdir -p "$out/bin"
      ln -s ${lib.getExe llmAgents.opencode2} "$out/bin/opencode"
    '')
    llmAgents.omp
    llmAgents.rtk

    antigravity-cli

    (callPackage ./pkgs/cli-proxy-api.nix { })
    (callPackage ./pkgs/codebase-memory-mcp.nix { })
    (callPackage ./pkgs/open-code-review.nix { })
    (callPackage ./pkgs/terminal-browser.nix { })

    # misc
    age
    p7zip
    curl
    wget
    wakeonlan
    mise
    just
    lazydocker
    btop
    cloudflared
    tailscale
    devcontainer
    glow
    rich-cli
    tdf

    # lint
    shellcheck
    ruff
    nixfmt
    oxlint

    # fonts
    inconsolata
    nerd-fonts.inconsolata
    nerd-fonts.symbols-only
  ]);
  denyPackages = config.localDeny.packages;
in
{
  options.localDeny.packages = lib.mkOption {
    type = lib.types.listOf lib.types.package;
    default = [ ];
    description = "Packages to remove from common home.packages";
  };

  options.localAllowUnfree.packages = lib.mkOption {
    type = lib.types.listOf lib.types.str;
    default = [ ];
    description = "Package names to permit under allowUnfreePredicate (merged across modules)";
  };

  config = {
    home.username = "{{ .chezmoi.username }}";
    home.homeDirectory = "{{ .chezmoi.homeDir }}";

    localAllowUnfree.packages = [
      "antigravity-cli"
      "discord"
      "ngrok"
      "terraform"
    ];

    nixpkgs.config.allowUnfreePredicate = pkg:
      builtins.elem (lib.getName pkg) config.localAllowUnfree.packages;

    # See https://search.nixos.org/packages
    home.packages = lib.lists.subtractLists denyPackages basePackages;

    programs.home-manager.enable = true;
    home.stateVersion = "25.11";

    xdg.configFile."nix/nix.conf".force = true;

    nix.package = pkgs.nix;

    nix.settings = {
      experimental-features = [ "nix-command" "flakes" ];
      extra-substituters = [
      {{- range .nix_substituters }}
        "{{ .url }}"
      {{- end }}
      ];
      extra-trusted-public-keys = [
      {{- range .nix_substituters }}
        "{{ .key }}"
      {{- end }}
      ];
    };

    programs.nh = {
      enable = true;
      clean = {
        enable = true;
        dates = "weekly";
        extraArgs = "--keep-since 30d --keep 1";
      };
    };

    # nixpkgs' rustup patchelf's every toolchain binary under ~/.rustup to a Nix
    # glibc loader, and wraps lld in a script that calls back into the rustup
    # package which installed it. Those paths live outside the store, so nothing
    # keeps them alive once the generation that referenced them is gone
    # (programs.nh.clean keeps only 30d / 1 generation), and then cargo fails
    # with "No such file or directory" or "ld-wrapper.sh: No such file or
    # directory". Repair both on every activation.
    home.activation.repairRustupToolchains = lib.mkIf pkgs.stdenv.hostPlatform.isLinux (
      lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        if [ -d "$HOME/.rustup/toolchains" ]; then
          # Missing interpreter: use the system loader, which cannot be
          # collected. A Nix loader only works through the rustup proxy, since
          # the toolchain also needs zlib from Nix.
          loader=/lib64/ld-linux-x86-64.so.2
          [ -e "$loader" ] || loader=${pkgs.stdenv.cc.bintools.dynamicLinker}
          ${pkgs.findutils}/bin/find "$HOME/.rustup/toolchains" -type f -perm -u+x |
            while IFS= read -r bin; do
              interp=$(${lib.getExe pkgs.patchelf} --print-interpreter "$bin" 2>/dev/null) || continue
              [ -n "$interp" ] && [ ! -e "$interp" ] || continue
              verboseEcho "repairing rustup toolchain binary: $bin"
              ${lib.getExe pkgs.patchelf} --set-interpreter "$loader" "$bin" ||
                warnEcho "failed to repair $bin"
            done

          # rustc links through this wrapper when it uses `-fuse-ld=lld`.
          for wrapper in "$HOME"/.rustup/toolchains/*/lib/rustlib/*/bin/gcc-ld/ld.lld; do
            [ -f "$wrapper" ] || continue
            ref=$(${pkgs.gnused}/bin/sed -n 's#.*"\(/nix/store/[^"]*/nix-support/ld-wrapper\.sh\)".*#\1#p' "$wrapper" | head -n 1)
            [ -n "$ref" ] && [ ! -e "$ref" ] || continue
            verboseEcho "repairing rustup lld wrapper: $wrapper"
            ${pkgs.gnused}/bin/sed -i "s#$ref#${pkgs.rustup}/nix-support/ld-wrapper.sh#" "$wrapper" ||
              warnEcho "failed to repair $wrapper"
          done
        fi
      ''
    );
  };
}
