import type { Plugin } from "@opencode/plugin"
import { existsSync } from "node:fs"
import { homedir } from "node:os"
import path from "node:path"

// Runs the shared guard hooks installed in ~/.claude/hooks (or ~/.codex/hooks)
// before opencode tool calls, with the same stdin JSON Claude Code sends. The
// list comes from the `opencode` tables in .chezmoidata/agent-hooks.toml.
//
// This pre-tool bridge blocks "ask" like "deny" rather than opening a permission
// prompt; a throw fails the tool call with the reason.

type Hook = { name: string; file: string; runner: string; tools: string[] }
type Block = { decision: string; reason: string }

{{- $hooks := list }}
{{- range .agent_hooks }}
{{-   if hasKey . "opencode" }}
{{-     $hooks = append $hooks (dict "name" .name "file" .file "runner" .runner "tools" .opencode.tools) }}
{{-   end }}
{{- end }}

const HOOKS: Hook[] = {{ $hooks | toJson }}

const LAUNCHERS: Record<string, string[]> = {
  bash: ["bash"],
  "uv-script": ["uv", "run", "--no-python-downloads", "--script"],
  bun: ["bun", "run"],
}
const HOOK_DIRS = [".claude/hooks", ".codex/hooks"].map((dir) => path.join(homedir(), dir))
const TIMEOUT_MS = 30_000

// rtk.ts may run first (opencode does not order plugins within a directory), and
// some guards do not look past an `rtk` / `rtk proxy` prefix, so they get the
// command without it.
const RTK_PREFIX = /(^|[;&|(`\n]\s*|\$\(\s*)((?:[A-Za-z_][A-Za-z0-9_]*=\S*\s+)*)rtk\s+(?:proxy\s+)?/g

// Claude Code's tool name and tool_input for an opencode tool call.
function claudeInput(tool: string, args: Record<string, unknown>): [string, Record<string, unknown>] | undefined {
  const text = (key: string) => (typeof args[key] === "string" ? (args[key] as string) : "")
  switch (tool) {
    case "bash":
      return text("command") ? ["Bash", { command: text("command").replace(RTK_PREFIX, "$1$2") }] : undefined
    case "write":
      return ["Write", { file_path: text("path"), content: text("content") }]
    case "edit":
      return ["Edit", { file_path: text("path"), old_string: text("oldString"), new_string: text("newString") }]
    case "apply_patch":
      return ["apply_patch", { command: text("patchText") }]
  }
  return undefined
}

async function runHook(argv: string[], payload: string, cwd: string): Promise<Block | undefined> {
  let stdout = ""
  let timer: ReturnType<typeof setTimeout> | undefined
  try {
    const proc = Bun.spawn(argv, { cwd, stdin: new Blob([payload]), stdout: "pipe", stderr: "ignore" })
    // A grandchild can keep the pipe open after the hook is killed, so the read races the timeout too.
    const timedOut = new Promise<string>((resolve) => {
      timer = setTimeout(() => {
        proc.kill()
        console.warn(`[guards] ${argv.at(-1)} timed out after ${TIMEOUT_MS} ms`)
        resolve("")
      }, TIMEOUT_MS)
    })
    stdout = await Promise.race([new Response(proc.stdout).text(), timedOut])
  } catch (error) {
    console.warn(`[guards] ${argv.at(-1)} failed to run: ${error}`)
    return undefined
  } finally {
    clearTimeout(timer)
  }
  if (!stdout.trim()) return undefined
  try {
    const out = JSON.parse(stdout).hookSpecificOutput ?? {}
    if (out.permissionDecision === "ask" || out.permissionDecision === "deny") {
      return { decision: out.permissionDecision, reason: String(out.permissionDecisionReason ?? "") }
    }
  } catch {
    console.warn(`[guards] ${argv.at(-1)} printed output that is not JSON`)
  }
  return undefined
}

export default {
  id: "guards",
  async setup(ctx) {
    const directory = ctx.location.directory
    const hooks = HOOKS.flatMap((hook) => {
      const file = HOOK_DIRS.map((dir) => path.join(dir, hook.file)).find((p) => existsSync(p))
      const launcher = LAUNCHERS[hook.runner]
      if (!file || !launcher) {
        console.warn(`[guards] ${hook.file} not found in ${HOOK_DIRS.join(" or ")}; skipped`)
        return []
      }
      return [{ ...hook, argv: [...launcher, file] }]
    })
    if (hooks.length === 0) return

    await ctx.tool.hook("execute.before", async (event) => {
      const raw = event.tool
      const tool = raw === "shell" ? "bash" : raw === "patch" ? "apply_patch" : raw
      const selected = hooks.filter((hook) => hook.tools.includes(tool))
      const args = event.input
      if (selected.length === 0 || !args || typeof args !== "object") return

      const claude = claudeInput(tool, args as Record<string, unknown>)
      if (!claude) return
      const [toolName, toolInput] = claude
      const workdir = (args as Record<string, unknown>).workdir
      const cwd = typeof workdir === "string" && workdir ? path.resolve(directory, workdir) : directory
      const payload = JSON.stringify({
        hook_event_name: "PreToolUse",
        session_id: event.sessionID ?? "",
        cwd,
        tool_name: toolName,
        tool_input: toolInput,
      })

      const results = await Promise.all(selected.map((hook) => runHook(hook.argv, payload, cwd)))
      const blocks = results.filter((block): block is Block => block !== undefined)
      if (blocks.length === 0) return
      const askHint =
        "\n\nThis needs the user's confirmation; this guard bridge cannot forward a confirmation prompt. " +
        "Ask the user to run the command themselves with ! in the opencode TUI."
      throw new Error(
        blocks.map(({ decision, reason }) => (decision === "ask" ? reason + askHint : reason)).join("\n\n"),
      )
    })
  },
} satisfies Plugin.Plugin
