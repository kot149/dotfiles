{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Apply nix-darwin configuration

set -e

{{- $src := printf "%s/" .chezmoi.sourceDir }}
{{- range sortAlpha (glob (joinPath .chezmoi.sourceDir "private_dot_config/nix-darwin/**")) }}
{{- $name := base . }}
{{- if not (or (stat .).isDir (hasPrefix "." $name) (hasSuffix "~" $name) (hasSuffix ".swp" $name)) }}
# {{ trimPrefix $src . }} hash: {{ include . | sha256sum }}
{{- end }}
{{- end }}
# data: username={{ .chezmoi.username }} hostname={{ .chezmoi.hostname }} arch={{ .chezmoi.arch }}

NIX_DARWIN_DIR="$HOME/.config/nix-darwin"

cd "$NIX_DARWIN_DIR"

echo "Applying nix-darwin configuration..."
if command -v nh >/dev/null 2>&1; then
  nh darwin switch "$NIX_DARWIN_DIR" -H "{{ .chezmoi.hostname }}"
else
  # Lock as the user so flake.lock is not created or rewritten by root
  nix --extra-experimental-features 'nix-command flakes' flake lock
  sudo -H nix --extra-experimental-features 'nix-command flakes' run github:nix-darwin/nix-darwin#darwin-rebuild -- switch --flake .#"{{ .chezmoi.hostname }}"
fi

echo "nix-darwin configuration applied successfully"
{{- end -}}
