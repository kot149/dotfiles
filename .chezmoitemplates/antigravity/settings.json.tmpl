{{- $perms := includeTemplate "agents/shell-permissions.tmpl" . | fromJson -}}
{{- $allowSet := dict -}}
{{- range $perms.allow -}}
  {{- $_ := set $allowSet . true -}}
{{- end -}}
{{- $allow := list -}}
{{- range $key, $_ := $allowSet -}}
  {{- $allow = append $allow (printf "command(%s)" $key) -}}
{{- end -}}
{{- $allow = sortAlpha $allow -}}
{{- $denySet := dict -}}
{{- range $perms.deny -}}
  {{- $_ := set $denySet . true -}}
{{- end -}}
{{- $deny := list -}}
{{- range $key, $_ := $denySet -}}
  {{- $deny = append $deny (printf "command(%s)" $key) -}}
{{- end -}}
{{- $deny = sortAlpha $deny -}}
{
  "permissions": {
    "allow": {{ $allow | toPrettyJson | indent 4 | trim }},
    "deny": {{ $deny | toPrettyJson | indent 4 | trim }}
  }
}
