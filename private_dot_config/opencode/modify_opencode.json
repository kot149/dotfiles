{{- /* chezmoi:modify-template */ -}}
{{- /* Merges .chezmoitemplates/opencode/opencode.json.tmpl into the live file: managed keys win at any depth, arrays are replaced. */ -}}
{{- /* Since v2 the opencode rules are one ordered array, which fromJson/toPrettyJson preserves, so the file can round-trip. */ -}}
{{- /* The pre-v2 "permission" object was fully managed by the template, so it is dropped after the merge. */ -}}
{{- $managed := includeTemplate "opencode/opencode.json.tmpl" . | trim -}}
{{- $current := "" -}}
{{- if trim .chezmoi.stdin -}}
{{-   $current = trim .chezmoi.stdin -}}
{{- end -}}
{{- $merged := trim (includeTemplate "agents/merge-config.tmpl" (dict "managed" $managed "current" $current "format" "json")) | fromJson -}}
{{- $_ := unset $merged "permission" -}}
{{ toPrettyJson $merged }}
