function mtouch {
  local f skip_value=0 after_dashes=0
  for f in "$@"; do
    if (( skip_value )); then
      skip_value=0
      continue
    fi
    if (( ! after_dashes )); then
      case "$f" in
        --) after_dashes=1; continue ;;
        --date|--reference) skip_value=1; continue ;;
        -[!-]*)
          # A short-flag cluster ending in -d/-t/-r/-A takes the next word as its value.
          [[ "${f[2,-1]}" != *[!acfhmdtrA]* && "$f" == *[dtrA] ]] && skip_value=1
          continue
          ;;
        -*) continue ;;
      esac
    fi
    mkdir -p -- "${f:h}"
  done
  command touch "$@"
}

