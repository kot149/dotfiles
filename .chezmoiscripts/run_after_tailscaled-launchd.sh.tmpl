{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail

# Self-healing tailscaled LaunchDaemon: runs on every `chezmoi apply`.
# Fast, sudo-free no-op when the daemon is already healthy; otherwise falls
# through to scripts/macos-launchd/tailscaled.sh, which rebuilds the plist,
# (re)bootstraps the job and applies the prefs. This covers the cases the
# previous run_onchange version missed: a job that was never (re)loaded
# (e.g. macOS upgrades move the plist back after launchd's boot scan) and
# a loaded job whose daemon fails to stay up.

PLIST=/Library/LaunchDaemons/com.tailscale.tailscaled.plist
LABEL=com.tailscale.tailscaled

if ! command -v tailscaled >/dev/null 2>&1; then
    if [ -e "$PLIST" ]; then
        echo "tailscale not installed; tearing down launchd configuration"
        sudo launchctl bootout system/"$LABEL" 2>/dev/null || true
        sudo rm -f "$PLIST"
    fi
    exit 0
fi

# Resolve to a root-readable executable, mirroring
# scripts/macos-launchd/tailscaled.sh.
TAILSCALED=$(readlink -f "$(command -v tailscaled)")
TAILSCALED_DIR=${TAILSCALED%/*}
if [ -x "$TAILSCALED_DIR/.tailscaled-wrapped" ]; then
    TAILSCALED="$TAILSCALED_DIR/.tailscaled-wrapped"
fi

if [ -e "$PLIST" ] \
    && [ "$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:0' "$PLIST" 2>/dev/null)" = "$TAILSCALED" ] \
    && launchctl print system/"$LABEL" >/dev/null 2>&1 \
    && tailscale status >/dev/null 2>&1; then
    exit 0
fi

echo "tailscaled LaunchDaemon missing or unhealthy; repairing"
sh "{{ .chezmoi.sourceDir }}/scripts/macos-launchd/tailscaled.sh"
{{- end -}}
