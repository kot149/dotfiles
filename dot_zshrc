# gh でマージ済みと分かるローカルブランチを、対応するワークツリーごと削除する。
# マージされたPRのheadより後に追加コミットがあるブランチは対象から除外する。
git-clean-merged() {
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "fatal: not a git repository" >&2
    return 1
  fi
  if ! command -v gh >/dev/null 2>&1; then
    echo "gh command not found" >&2
    return 1
  fi

  local default_branch current_branch
  default_branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')
  default_branch="${default_branch:-main}"
  current_branch=$(git branch --show-current)

  local -A worktree_of_branch
  local wt_path wt_branch line
  while IFS= read -r line; do
    case "$line" in
      worktree\ *) wt_path="${line#worktree }" ;;
      branch\ refs/heads/*)
        wt_branch="${line#branch refs/heads/}"
        worktree_of_branch[$wt_branch]="$wt_path"
        ;;
    esac
  done < <(git worktree list --porcelain)

  local -a targets skipped skipped_dirty
  local branch head_sha pr_head

  while IFS= read -r branch; do
    [[ "$branch" == "$default_branch" || "$branch" == "$current_branch" ]] && continue

    pr_head=$(gh pr list --state merged --head "$branch" --json headRefOid --jq '.[0].headRefOid' 2>/dev/null)
    [[ -z "$pr_head" || "$pr_head" == "null" ]] && continue

    head_sha=$(git rev-parse "$branch")
    if [[ "$head_sha" != "$pr_head" ]]; then
      skipped+=("$branch")
      continue
    fi

    if [[ -n "${worktree_of_branch[$branch]:-}" ]] &&
        [[ -n "$(git -C "${worktree_of_branch[$branch]}" status --porcelain --untracked-files=normal 2>/dev/null)" ]]; then
      skipped_dirty+=("$branch")
      continue
    fi

    targets+=("$branch")
  done < <(git for-each-ref --format='%(refname:short)' refs/heads/)

  if (( ${#skipped[@]} > 0 )); then
    echo "Skipped (commits added after the merge):"
    printf '  %s\n' "${skipped[@]}"
  fi

  if (( ${#skipped_dirty[@]} > 0 )); then
    echo "Skipped (worktree has uncommitted changes):"
    printf '  %s\n' "${skipped_dirty[@]}"
  fi

  if (( ${#targets[@]} == 0 )); then
    echo "No merged branches to delete."
    return 0
  fi

  echo "The following branches will be deleted (with their worktree if any):"
  local b
  for b in "${targets[@]}"; do
    if [[ -n "${worktree_of_branch[$b]:-}" ]]; then
      echo "  $b (worktree: ${worktree_of_branch[$b]})"
    else
      echo "  $b"
    fi
  done

  local reply
  read -q "reply?Proceed? [y/N] "
  echo
  [[ "$reply" == "y" ]] || return 0

  for b in "${targets[@]}"; do
    if [[ -n "${worktree_of_branch[$b]:-}" ]]; then
      if ! git worktree remove "${worktree_of_branch[$b]}"; then
        echo "Kept branch $b: its worktree could not be removed" >&2
        continue
      fi
    fi
    git branch -D "$b"
  done
}

