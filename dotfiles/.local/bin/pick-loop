#!/usr/bin/env bash
# Run fzf over the given entries and hand the selected one to a command,
# reopening the picker when that command exits. Quitting the picker with Esc, q
# or Left arrow leaves for good.
#
# Usage: pick-loop <prompt> <entry>... -- <command> [args...]
#
# An entry is "<label><TAB><action>". The action is split on spaces and appended
# to the command; "@none" marks a non-selectable header. Neither fzf nor the
# command gets a redirected stdin: they inherit the terminal, which a full
# screen TUI needs.
set -euo pipefail

if [ "$#" -lt 1 ]; then
  echo "pick-loop: usage: pick-loop <prompt> <entry>... -- <command> [args...]" >&2
  exit 2
fi

prompt="$1"
shift

items=()
actions=()
while [ "$#" -gt 0 ]; do
  if [ "$1" = "--" ]; then
    shift
    break
  fi
  items+=("${1%%$'\t'*}")
  actions+=("${1#*$'\t'}")
  shift
done

if [ "${#items[@]}" -eq 0 ]; then
  echo "pick-loop: no entries given" >&2
  exit 2
fi

if [ "$#" -eq 0 ]; then
  echo "pick-loop: no command given" >&2
  exit 2
fi

# The entries fzf shows for a query. --no-sort keeps them in input order, which
# is what the interactive picker displays too.
filtered_items() {
  if [ -z "$1" ]; then
    printf '%s\n' "${items[@]}"
  else
    printf '%s\n' "${items[@]}" | fzf --filter="$1" --no-sort || true
  fi
}

# 1-based position of an entry among the filtered ones, so the cursor can be
# restored when the picker reopens.
cursor_position() {
  local target="$1" query="$2" position=1 line
  while IFS= read -r line; do
    if [ "${line}" = "${target}" ]; then
      printf '%s' "${position}"
      return
    fi
    position=$(( position + 1 ))
  done < <(filtered_items "${query}")
  printf '1'
}

# Index of an entry in items, or -1 when it is not there.
entry_index() {
  local target="$1" i
  for i in "${!items[@]}"; do
    if [ "${items[$i]}" = "${target}" ]; then
      printf '%s' "$i"
      return
    fi
  done
  printf '%s' -1
}

query=""
position=1

while true; do
  # --print-query puts the query on the first line, the selection on the second.
  # pos() needs the result event because filtering is not done yet on start.
  fzf_output="$(printf '%s\n' "${items[@]}" | fzf \
    --prompt="${prompt}" --height=100% --reverse --no-sort --sync \
    --print-query --query="${query}" \
    --bind='q:abort,left:abort' \
    --bind="result:pos(${position})+unbind(result)")" || exit 0

  mapfile -t fzf_lines <<<"${fzf_output}"
  query="${fzf_lines[0]-}"
  choice="${fzf_lines[1]-}"
  if [ -z "${choice}" ]; then
    exit 0
  fi
  position="$(cursor_position "${choice}" "${query}")"

  index="$(entry_index "${choice}")"
  if [ "${index}" -lt 0 ]; then
    continue
  fi
  action="${actions[$index]}"
  if [ "${action}" = "@none" ]; then
    continue
  fi

  read -r -a action_args <<<"${action}"

  status=0
  "$@" ${action_args[@]+"${action_args[@]}"} || status=$?
  if [ "${status}" -ne 0 ]; then
    echo "pick-loop: $1 exited with status ${status}" >&2
    exit "${status}"
  fi
done
