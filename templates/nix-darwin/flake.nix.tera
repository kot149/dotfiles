{% set_global nix_arch = arch() -%}
{% if arch() == "x64" %}{% set_global nix_arch = "x86_64" %}{% elif arch() == "arm64" %}{% set_global nix_arch = "aarch64" %}{% endif -%}
{  description = "Nix Darwin configuration";

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs/nixpkgs-unstable";
    nix-darwin = {
      url = "github:LnL7/nix-darwin";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = {
    self,
    nixpkgs,
    nix-darwin,
  }: {
    darwinConfigurations.{{ exec(command="hostname -s") | trim }} = nix-darwin.lib.darwinSystem {
      system = "{{ nix_arch }}-darwin";
      modules = [ ./darwin-configuration.nix ];
    };
  };
}
