{
  description = "Home Manager configuration";

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs/nixpkgs-unstable";
    home-manager = {
      url = "github:nix-community/home-manager";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    # Source of every AI CLI (claude-code, codex, herdr, hunk, ax, opencode,
    # omp, rtk). Deliberately not following nixpkgs: the cache at
    # cache.numtide.com is built against the pins in this flake, and its own
    # nixpkgs still supports x86_64-darwin, which it evaluates for all systems.
    llm-agents.url = "github:numtide/llm-agents.nix";
    # Deliberately not following nixpkgs: the terraform builds cached at
    # nixpkgs-terraform.cachix.org are made against the pins in this flake, so
    # overriding nixpkgs changes the store path and forces a local Go build of
    # an unfree package that cache.nixos.org will never carry.
    nixpkgs-terraform.url = "github:stackbuilders/nixpkgs-terraform";
    {{- if eq .chezmoi.os "linux" }}
    nixgl = {
      url = "github:nix-community/nixGL";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    {{- end }}
  };

  outputs = { nixpkgs, home-manager, llm-agents, nixpkgs-terraform{{ if eq .chezmoi.os "linux" }}, nixgl{{ end }}, ... }:
    let
      {{ $nixArch := .chezmoi.arch -}}
      {{- if eq .chezmoi.arch "amd64" }}{{ $nixArch = "x86_64" }}{{ end -}}
      {{- if eq .chezmoi.arch "arm64" }}{{ $nixArch = "aarch64" }}{{ end -}}
      {{- $system := printf "%s-%s" $nixArch .chezmoi.os -}}
      {{- $wsl := and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) }}
      system = "{{ $system }}";
      username = "{{ .chezmoi.username }}";
    in {
      homeConfigurations.default = home-manager.lib.homeManagerConfiguration {
        pkgs = nixpkgs.legacyPackages.${system};
        modules = [
          ./common.nix
          {{ if eq .chezmoi.os "linux" -}}
          ./linux-common.nix
          {{- $wsl := and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) }}
          {{- if $wsl }}
          ./wsl.nix
          {{- end }}
          {{- if and (hasKey . "linuxGui") .linuxGui }}
          ./linux-desktop.nix
          {{- else if and (hasKey . "linuxGui") (not .linuxGui) }}
          ./linux-headless.nix
          {{- else if $wsl }}
          ./linux-headless.nix
          {{- else }}
          ./linux-desktop.nix
          {{- end }}
          {{ else if eq .chezmoi.os "darwin" -}}
          ./darwin.nix
          {{ end -}}
        ] ++ (if builtins.pathExists ./local.nix then [ ./local.nix ] else []);
        extraSpecialArgs = {
          inherit username;
          llmAgents = llm-agents.packages.${system};
          nixTerraform = nixpkgs-terraform.packages.${system}."terraform-1.14";
          {{- if eq .chezmoi.os "linux" }}
          # Same set as nixgl.packages, but nixGL.nix still takes the removed
          # pcre for pcregrep, so it gets a pcre2grep shim instead.
          # Drop once nix-community/nixGL#227 is merged.
          nixglPackages =
            let
              pkgs = nixpkgs.legacyPackages.${system};
              isIntelX86 = system == "x86_64-linux";
              pcregrep = pkgs.runCommand "pcregrep-shim" { } ''
                mkdir -p $out/bin
                ln -s ${pkgs.pcre2.bin}/bin/pcre2grep $out/bin/pcregrep
              '';
              nixGL = pkgs.callPackage "${nixgl}/nixGL.nix" (
                { pcre = pcregrep; enable32bits = isIntelX86; }
                // (if isIntelX86 then { } else { intel-media-driver = null; })
              );
            in {
              default = nixGL.auto.nixGLDefault;
              nixGLDefault = nixGL.auto.nixGLDefault;
              nixGLNvidia = nixGL.auto.nixGLNvidia;
              nixGLNvidiaBumblebee = nixGL.auto.nixGLNvidiaBumblebee;
              nixGLIntel = nixGL.nixGLIntel;
              nixVulkanNvidia = nixGL.auto.nixVulkanNvidia;
              nixVulkanIntel = nixGL.nixVulkanIntel;
            };
          {{- end }}
          {{- if $wsl }}
          isWsl = true;
          {{- end }}
        };

      };
    };
}
