root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.nix]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 4

[.chezmoitemplates/agents/keychain-cred.sh]
indent_style = tab

[dot_claude/executable_*.sh]
indent_size = 2

[dot_local/bin/executable_*]
indent_style = space
indent_size = 2

[justfile]
indent_style = space
indent_size = 4

[**/toggleDotFile]
insert_final_newline = false
