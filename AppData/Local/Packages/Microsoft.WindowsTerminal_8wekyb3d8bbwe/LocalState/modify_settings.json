{{- /* chezmoi:modify-template */ -}}
{{- /* Overwrites the managed keys below and keeps everything else Windows Terminal writes (auto-generated profiles, etc.). */ -}}
{{- $managed := `
{
    "actions": [
        { "command": { "action": "splitPane", "split": "auto", "splitMode": "duplicate" }, "id": "User.splitPane.A6751878" },
        { "command": "find", "id": "User.find" },
        { "command": "paste", "id": "User.paste" },
        { "command": { "action": "newTab" }, "id": "User.newTab.5DEADB41" },
        { "command": { "action": "copy", "singleLine": false }, "id": "User.copy.644BA8F2" },
        { "command": { "action": "prevTab" }, "id": "User.prevTab.0" },
        { "command": "closePane", "id": "User.closePane" },
        { "command": { "action": "nextTab" }, "id": "User.nextTab.0" }
    ],
    "centerOnLaunch": true,
    "copyFormatting": "none",
    "copyOnSelect": true,
    "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
    "initialCols": 150,
    "initialPosition": "1500,750",
    "initialRows": 40,
    "keybindings": [
        { "id": "User.paste", "keys": "ctrl+v" },
        { "id": "User.closePane", "keys": "ctrl+shift+w" },
        { "id": "User.find", "keys": "ctrl+f" },
        { "id": "User.splitPane.A6751878", "keys": "alt+shift+d" },
        { "id": "User.copy.644BA8F2", "keys": "ctrl+c" },
        { "id": "User.newTab.5DEADB41", "keys": "ctrl+shift+t" },
        { "id": "User.prevTab.0", "keys": "ctrl+pgup" },
        { "id": "User.nextTab.0", "keys": "ctrl+pgdn" }
    ],
    "language": "en-US",
    "launchMode": "default",
    "newTabMenu": [ { "type": "remainingProfiles" } ],
    "showTabsInTitlebar": true,
    "tabSwitcherMode": "inOrder",
    "theme": "dark"
}
` | fromJson -}}
{{- $profileDefaults := `
{
    "backgroundImage": null,
    "font": { "face": "Inconsolata Nerd Font", "size": 12, "weight": "thin" },
    "opacity": 100,
    "useAcrylic": true
}
` | fromJson -}}
{{- $profiles := `
[
    {
        "commandline": "cmd.exe /K \"%CLINK_DIR%\\clink\" inject",
        "guid": "{8a91f78d-7291-44cc-a9d5-f81be64a1849}",
        "hidden": false,
        "icon": "C:\\Program Files (x86)\\clink\\clink.ico",
        "name": "Clink",
        "tabTitle": "Clink"
    },
    {
        "commandline": "pwsh",
        "guid": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
        "hidden": false,
        "name": "PowerShell 7",
        "source": "Windows.Terminal.PowershellCore"
    },
    {
        "commandline": "cmd.exe /K \"%CLINK_DIR%\\clink\" inject",
        "elevate": true,
        "guid": "{f4f9b655-ffec-485b-b72c-2014f45fa6c5}",
        "hidden": false,
        "icon": "C:\\Program Files (x86)\\clink\\clink.ico",
        "name": "Clink (Admin)",
        "tabTitle": "Clink"
    },
    {
        "colorScheme": "Campbell",
        "commandline": "\"C:\\Program Files\\PowerShell\\7\\pwsh.exe\"",
        "elevate": true,
        "guid": "{ba9857c2-0797-42ae-8b10-da5dfd65733a}",
        "hidden": false,
        "icon": "ms-appx:///ProfileIcons/pwsh.png",
        "name": "PowerShell 7 (Admin)",
        "startingDirectory": "%USERPROFILE%"
    }
]
` | fromJson -}}

{{- $settings := dict -}}
{{- if trim .chezmoi.stdin -}}
{{-   $settings = .chezmoi.stdin | fromJson -}}
{{- end -}}
{{- range $key, $value := $managed -}}
{{-   $_ := set $settings $key $value -}}
{{- end -}}
{{- $_ := unset $settings "defaultInputScope" -}}

{{- $profileSection := get $settings "profiles" | default dict -}}
{{- $_ := set $profileSection "defaults" $profileDefaults -}}

{{- /* Replace managed profiles in place by guid, append missing ones. */ -}}
{{- $byGuid := dict -}}
{{- range $profiles -}}
{{-   $_ := set $byGuid .guid . -}}
{{- end -}}
{{- $list := list -}}
{{- range get $profileSection "list" | default list -}}
{{-   if hasKey $byGuid .guid -}}
{{-     $list = append $list (get $byGuid .guid) -}}
{{-     $_ := unset $byGuid .guid -}}
{{-   else -}}
{{-     $list = append $list . -}}
{{-   end -}}
{{- end -}}
{{- range $profiles -}}
{{-   if hasKey $byGuid .guid -}}
{{-     $list = append $list . -}}
{{-   end -}}
{{- end -}}
{{- $_ := set $profileSection "list" $list -}}
{{- $_ := set $settings "profiles" $profileSection -}}

{{- toPrettyJson $settings }}
