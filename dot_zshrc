unalias rm 2>/dev/null
rm() {
  local -a opts paths
  local arg letters
  local force=0 inspect=0 after_dashes=0
  for arg in "$@"; do
    if (( after_dashes )); then
      paths+=("$arg")
      continue
    fi
    case "$arg" in
      -r|-R|--recursive) ;;                     # rip is always recursive
      -f|--force) force=1 ;;                    # rip -f: non-interactive
      -i|--interactive) inspect=1 ;;            # rip -i: inspect before burying
      -v|--verbose|-d|--dir) ;;                 # no rip equivalent; drop
      --) after_dashes=1 ;;                     # everything after -- is a path
      -[!-]*)                                   # combined short flags, e.g. -rf, -rdf
        letters="${arg[2,-1]}"
        if [[ "$letters" == *[!rRfivd]* ]]; then
          print -u2 "rm: unsupported flag in $arg (use 'command rm')"
          return 2
        fi
        [[ "$letters" == *f* ]] && force=1
        [[ "$letters" == *i* ]] && inspect=1
        ;;
      --*) print -u2 "rm: unsupported flag $arg (use 'command rm')"; return 2 ;;
      *) paths+=("$arg") ;;
    esac
  done
  # rip rejects repeated flags, so each is passed once before the paths.
  (( force )) && opts+=(-f)
  (( inspect )) && opts+=(-i)
  (( after_dashes )) && opts+=(--)
  command rip "${opts[@]}" "${paths[@]}"
}

