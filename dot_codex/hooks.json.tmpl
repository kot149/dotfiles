{{- $home := .chezmoi.homeDir | replace "\\" "/" -}}
{
  "description": "User-level Codex hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|Shell)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ $home }}/.codex/hooks/check-force-push.sh'",
            "timeout": 15,
            "statusMessage": "Checking force push"
          },
          {
            "type": "command",
            "command": "bash '{{ $home }}/.codex/hooks/check-github-api-write.sh'",
            "timeout": 15,
            "statusMessage": "Checking GitHub API write"
          },
          {
            "type": "command",
            "command": "bash '{{ $home }}/.codex/hooks/check-package-manager.sh'",
            "commandWindows": "pwsh -NoProfile -File \"{{ $home }}/.codex/hooks/check-package-manager.ps1\"",
            "timeout": 15,
            "statusMessage": "Checking package manager"
          },
          {
            "type": "command",
            "command": "bash '{{ $home }}/.codex/hooks/check-commit-sha-links.sh'",
            "timeout": 15,
            "statusMessage": "Checking commit SHA links"
          },
          {
            "type": "command",
            "command": "bash '{{ $home }}/.codex/hooks/check-cargo-install.sh'",
            "timeout": 15,
            "statusMessage": "Checking cargo install"
          }
        ]
      },
      {
        "matcher": "^(Bash|Shell|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "bun run '{{ $home }}/.codex/hooks/check-writing-style.js'",
            "timeout": 30,
            "statusMessage": "Checking writing style"
          }
        ]
      }
    ]{{ if ne .chezmoi.os "windows" }},
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ $home }}/.agents/memsearch/codex/hooks/session-start.sh'",
            "timeout": 30,
            "statusMessage": "Loading memsearch memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ $home }}/.agents/memsearch/codex/hooks/user-prompt-submit.sh'",
            "timeout": 10,
            "statusMessage": "Checking memsearch recall"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ $home }}/.agents/memsearch/codex/hooks/stop.sh'",
            "timeout": 30,
            "statusMessage": "Saving memsearch memory"
          }
        ]
      }
    ]{{ end }}
  }
}
