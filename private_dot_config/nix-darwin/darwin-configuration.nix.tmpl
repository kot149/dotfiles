{pkgs, ...}: {
  # https://nix-darwin.github.io/nix-darwin/manual/index.html

  imports = [./custom-user-preferences.nix];

  nix = {
    enable = false;
    # optimise.automatic = true;
    # settings = {
    #   experimental-features = "nix-command flakes";
    #   auto-optimise-store = true;
    # };
  };

  system.stateVersion = 6;

  system.primaryUser = "{{ .chezmoi.username }}";

  system.startup.chime = false;

  system = {
    defaults = {
      NSGlobalDomain.AppleShowAllExtensions = true;
      NSGlobalDomain.ApplePressAndHoldEnabled = false;
      finder = {
        AppleShowAllFiles = true;
        AppleShowAllExtensions = true;
        FXPreferredViewStyle = "clmv"; # prefer column view
        QuitMenuItem = true; # allow quitting Finder
        ShowPathbar = true;
        ShowStatusBar = false;
      };
      dock = {
        autohide = true;
        autohide-delay = 0.0;
        autohide-time-modifier = 0.5;
        show-recents = true;
        orientation = "bottom";
      };
      CustomUserPreferences = {
        # 日本語IME (ことえり) の「Windows風のキー操作」
        "com.apple.inputmethod.Kotoeri".JIMPrefWindowsModeKey = true;
      };
    };
  };

  security.pam.services.sudo_local.touchIdAuth = true;

  homebrew = {
    enable = true;
    onActivation = {
      autoUpdate = true;
      # cleanup = "uninstall";
    };
    brews = [
    ];
    casks = [
      "appcleaner"
      "azookey"
      "coteditor"
      "devtoys"
      "dockdoor"
      "fuwari"
      "hiddenbar"
      "homerow"
      "karabiner-elements"
      "linearmouse"
      "lm-studio"
      "notunes"
      "openinterminal"
      "slack"
      "raycast"
      "rectangle"
      "space-rabbit"
      "visual-studio-code"
    ];
  };

  # Automatically apply nix-darwin config changes
  # nix-darwin runs only its predefined activation script names, so this must be postActivation
  system.activationScripts.postActivation.text = ''
    # Disable Spotlight indexing and its Cmd+Space / Cmd+Option+Space shortcuts (Raycast replaces it)
    mdutil -a -i off >/dev/null
    for key in 64 65; do
      sudo -u {{ .chezmoi.username }} defaults write com.apple.symbolichotkeys AppleSymbolicHotKeys \
        -dict-add "$key" "<dict><key>enabled</key><false/></dict>"
    done
    sudo -u {{ .chezmoi.username }} /System/Library/PrivateFrameworks/SystemAdministration.framework/Resources/activateSettings -u
  '';
}
