#!/usr/bin/env bash
# Pick a diff range with fzf and open it in hunk. Quitting hunk returns to the
# picker; leave for good with Esc, q or Left arrow there.
set -euo pipefail

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "hunk-pick: not inside a git repository" >&2
  exit 1
fi

empty_tree="$(git hash-object -t tree /dev/null)"

# A repository without any commit has no HEAD, and no base branch to compare
# against, so the entries that need a revision are built accordingly.
has_head=false
if git rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
  has_head=true
fi

default_base="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)"

max_base_candidates=50

# Refs that could be the branch point, in preference order for ties: the
# repository default branch first, then recently updated local and origin
# branches.
candidate_refs() {
  printf '%s\n' "${default_base}"
  git for-each-ref --sort=-committerdate --count="${max_base_candidates}" \
    --format='%(refname:short)' refs/heads refs/remotes/origin 2>/dev/null || true
}

# The branch the current one was most likely created from: the candidate with
# the fewest commits between its merge base and HEAD. Ancestors of HEAD win over
# diverged branches, so a base that has moved on does not beat the real one.
detect_base() {
  local current cand ahead rank best_base="" best_rank="" best_ahead=""

  current="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)"

  while IFS= read -r cand; do
    [ -n "${cand}" ] || continue
    case "${cand}" in
      "${current}" | "origin/${current}" | origin/HEAD) continue ;;
    esac
    git rev-parse --verify --quiet "${cand}^{commit}" >/dev/null || continue

    # Commits HEAD has that the candidate does not. Zero means HEAD is already
    # contained in it, so there is no branch diff to show.
    ahead="$(git rev-list --count "${cand}..HEAD" 2>/dev/null || echo 0)"
    [ "${ahead}" -gt 0 ] || continue

    if git merge-base --is-ancestor "${cand}" HEAD 2>/dev/null; then
      rank=0
    else
      rank=1
    fi

    if [ -z "${best_base}" ] ||
      [ "${rank}" -lt "${best_rank}" ] ||
      { [ "${rank}" -eq "${best_rank}" ] && [ "${ahead}" -lt "${best_ahead}" ]; }; then
      best_base="${cand}"
      best_rank="${rank}"
      best_ahead="${ahead}"
    fi
  done < <(candidate_refs)

  printf '%s' "${best_base:-${default_base}}"
}

# HUNK_PICK_BASE overrides the detection, e.g. when the branch point is
# ambiguous.
if [ "${has_head}" = true ]; then
  base="${HUNK_PICK_BASE:-$(detect_base)}"
else
  base="${HUNK_PICK_BASE:-${default_base}}"
fi

has_base=false
if [ "${has_head}" = true ] && git rev-parse --verify --quiet "${base}^{commit}" >/dev/null 2>&1; then
  has_base=true
fi

# Parallel arrays: labels[i] is shown by fzf, actions[i] holds the arguments
# passed to `hunk diff` (space separated, "@none" for a non-selectable header).
labels=()
actions=()

add_entry() {
  labels+=("$1")
  actions+=("$2")
}

if [ "${has_head}" = true ]; then
  add_entry "Uncommitted changes (unstaged + staged)" "HEAD"
else
  add_entry "Uncommitted changes (unstaged + staged)" "${empty_tree}"
fi
add_entry " ├─ Unstaged changes" ""
add_entry " └─ Staged changes" "--staged"

max_commits=50

# Commits on the current branch, newest first. Falls back to recent history
# when the branch has no commits ahead of the base (e.g. sitting on main).
commits=()
if [ "${has_head}" = true ]; then
  range=HEAD
  if [ "${has_base}" = true ]; then
    range="${base}..HEAD"
  fi
  while IFS= read -r line; do
    commits+=("$line")
  done < <(git log --format='%h %s' -n "${max_commits}" "${range}" 2>/dev/null || true)

  if [ "${#commits[@]}" -eq 0 ] && [ "${has_base}" = true ]; then
    while IFS= read -r line; do
      commits+=("$line")
    done < <(git log --format='%h %s' -n "${max_commits}" HEAD 2>/dev/null || true)
  fi
fi

# Children of the branch section: the combined branch + uncommitted entry
# followed by the individual commits.
child_labels=()
child_actions=()

if [ "${has_base}" = true ]; then
  child_labels+=("Branch changes + uncommitted changes (${base})")
  child_actions+=("${base}")
fi

if [ "${#commits[@]}" -gt 0 ]; then
  for i in "${!commits[@]}"; do
    sha="${commits[$i]%% *}"
    if git rev-parse --verify --quiet "${sha}^" >/dev/null 2>&1; then
      child_actions+=("${sha}^..${sha}")
    else
      child_actions+=("${empty_tree}..${sha}")
    fi
    child_labels+=("${commits[$i]}")
  done
fi

if [ "${#child_labels[@]}" -gt 0 ]; then
  if [ "${has_base}" = true ]; then
    add_entry "Branch changes (${base}...HEAD)" "${base}...HEAD"
  else
    add_entry "Commits" "@none"
  fi

  last=$(( ${#child_labels[@]} - 1 ))
  for i in "${!child_labels[@]}"; do
    if [ "$i" -eq "$last" ]; then
      add_entry " └─ ${child_labels[$i]}" "${child_actions[$i]}"
    else
      add_entry " ├─ ${child_labels[$i]}" "${child_actions[$i]}"
    fi
  done
fi

items=("${labels[@]}")

# The entries fzf shows for a query. --no-sort keeps them in input order, which
# is what the interactive picker displays too.
filtered_items() {
  if [ -z "$1" ]; then
    printf '%s\n' "${items[@]}"
  else
    printf '%s\n' "${items[@]}" | fzf --filter="$1" --no-sort || true
  fi
}

# 1-based position of an entry among the filtered ones, so the cursor can be
# restored when the picker reopens.
cursor_position() {
  local target="$1" query="$2" position=1 line
  while IFS= read -r line; do
    if [ "${line}" = "${target}" ]; then
      printf '%s' "${position}"
      return
    fi
    position=$(( position + 1 ))
  done < <(filtered_items "${query}")
  printf '1'
}

# Index of an entry in items, or -1 when it is not there.
entry_index() {
  local target="$1" i
  for i in "${!items[@]}"; do
    if [ "${items[$i]}" = "${target}" ]; then
      printf '%s' "$i"
      return
    fi
  done
  printf '%s' -1
}

query=""
position=1

while true; do
  # --print-query puts the query on the first line, the selection on the second.
  # pos() needs the result event because filtering is not done yet on start.
  fzf_output="$(printf '%s\n' "${items[@]}" | fzf \
    --prompt='hunk diff > ' --height=100% --reverse --no-sort --sync \
    --print-query --query="${query}" \
    --bind='q:abort,left:abort' \
    --bind="result:pos(${position})+unbind(result)")" || exit 0

  mapfile -t fzf_lines <<<"${fzf_output}"
  query="${fzf_lines[0]-}"
  choice="${fzf_lines[1]-}"
  if [ -z "${choice}" ]; then
    exit 0
  fi
  position="$(cursor_position "${choice}" "${query}")"

  index="$(entry_index "${choice}")"
  if [ "${index}" -lt 0 ]; then
    continue
  fi
  action="${actions[$index]}"
  if [ "${action}" = "@none" ]; then
    continue
  fi

  read -r -a diff_args <<<"${action}"

  status=0
  hunk diff ${diff_args[@]+"${diff_args[@]}"} || status=$?
  if [ "${status}" -ne 0 ]; then
    echo "hunk-pick: hunk exited with status ${status}" >&2
    exit "${status}"
  fi
done
