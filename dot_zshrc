gh() {
  local repo
  if [[ -z "${GH_REPO:-}" ]] && [[ -z "$(git config --get-regexp '^remote\..*\.gh-resolved$' 2>/dev/null)" ]]; then
    repo=$(git remote get-url origin 2>/dev/null | sed -E 's|^ssh://||; s|^https?://github\.com/||; s|^git@github\.com[^:/]*[:/]||; s|\.git$||')
    [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] && local -x GH_REPO="$repo"
  fi
  command gh "$@"
}

