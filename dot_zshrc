# herdr: 現在のワークスペースを main(2分割) / lazygit / nvim の3タブ構成にする
hdr-init() {
  if [[ "$HERDR_ENV" != "1" ]]; then
    echo "hdr-init: not running inside a herdr session" >&2
    return 1
  fi
  if ! command -v herdr >/dev/null 2>&1; then
    echo "herdr: command not found" >&2
    return 1
  fi
  if ! command -v jq >/dev/null 2>&1; then
    echo "hdr-init: jq is required" >&2
    return 1
  fi

  local ws main_pane main_tab sub_pane nv_pane
  ws=$(herdr workspace list | jq -r '.result.workspaces[] | select(.focused).workspace_id')
  if [[ -z "$ws" ]]; then
    echo "hdr-init: could not resolve focused workspace" >&2
    return 1
  fi

  main_pane=$(herdr pane list | jq -r --arg ws "$ws" '.result.panes[] | select(.workspace_id==$ws and .focused).pane_id')
  if [[ -z "$main_pane" ]]; then
    echo "hdr-init: could not resolve focused pane" >&2
    return 1
  fi
  main_tab=$(herdr pane list | jq -r --arg p "$main_pane" '.result.panes[] | select(.pane_id==$p).tab_id')

  # tab1: main (2分割)
  herdr tab rename "$main_tab" "main" >/dev/null
  herdr pane split "$main_pane" --direction right --no-focus >/dev/null

  # tab2: sub (2分割)
  sub_pane=$(herdr tab create --workspace "$ws" --label "sub" --no-focus | jq -r '.result.root_pane.pane_id')
  herdr pane split "$sub_pane" --direction right --no-focus >/dev/null

  # tab3: nvim
  nv_pane=$(herdr tab create --workspace "$ws" --label "nvim" --no-focus | jq -r '.result.root_pane.pane_id')
  herdr pane run "$nv_pane" "nvim ."

  herdr tab focus "$main_tab"
}

# herdr: 開いている popup をソケット API (popup.close) で閉じる。popup が固まったときは herdr 外から実行する
hdr-popup-close() {
  uv run --no-project python -c '
import json, os, socket
s = socket.socket(socket.AF_UNIX)
s.connect(os.path.expanduser("~/.config/herdr/herdr.sock"))
s.sendall((json.dumps({"id": "1", "method": "popup.close", "params": {}}) + "\n").encode())
print(s.recv(4096).decode().strip())
'
}

