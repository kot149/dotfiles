{{- define "codexPattern" -}}
{{- $tokens := list -}}
{{- range (splitList " " .) -}}
  {{- $token := trimAll "*" . -}}
  {{- if ne $token "" -}}
    {{- $tokens = append $tokens $token -}}
  {{- end -}}
{{- end -}}
{{- $tokens | toJson -}}
{{- end -}}
{{- range .agent_shell_deny }}
prefix_rule(pattern={{ template "codexPattern" . }}, decision="forbidden", justification="Blocked by shared agent deny list")
prefix_rule(pattern={{ template "codexPattern" (printf "rtk %s" .) }}, decision="forbidden", justification="Blocked by shared agent deny list")
{{- end }}
{{- $shellAllow := list -}}
{{- range .agent_shell_allow -}}
  {{- $shellAllow = append $shellAllow . -}}
{{- end -}}
{{- $scriptPrefixes := list "npm run" "pnpm run" "pnpm" "yarn run" "yarn" "bun run" "bun" -}}
{{- range .agent_shell_allow_js_scripts -}}
  {{- $script := . -}}
  {{- range $scriptPrefixes -}}
    {{- $shellAllow = append $shellAllow (printf "%s %s *" . $script) -}}
  {{- end -}}
{{- end -}}
{{- $binPrefixes := list "npx" "pnpm exec" "pnpm dlx" "pnpm" "yarn exec" "yarn dlx" "yarn" "bunx" "bun x" "bun" -}}
{{- range .agent_shell_allow_js_bins -}}
  {{- $bin := . -}}
  {{- $shellAllow = append $shellAllow (printf "%s *" $bin) -}}
  {{- range $binPrefixes -}}
    {{- $shellAllow = append $shellAllow (printf "%s %s *" . $bin) -}}
  {{- end -}}
{{- end }}
{{- range $shellAllow }}
prefix_rule(pattern={{ template "codexPattern" . }}, decision="allow")
prefix_rule(pattern={{ template "codexPattern" (printf "rtk %s" .) }}, decision="allow")
{{- end }}
{{- range .agent_shell_allow_no_rtk }}
prefix_rule(pattern={{ template "codexPattern" . }}, decision="allow")
{{- end }}
