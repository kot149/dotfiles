#!/bin/bash
set -euo pipefail

# checksum: {{ include (printf ".chezmoitemplates/%s" .template) | sha256sum }}

tmpfile=$(mktemp -t {{ .name }}.plist.XXXXXX)
cleanup() { rm -f "$tmpfile"; }
trap cleanup EXIT INT HUP TERM

# Render template to a temporary file
cat >"$tmpfile" <<'PLIST'
{{ include (printf ".chezmoitemplates/%s" .template) }}
PLIST

# Validate the generated plist (must be XML1 or binary)
/usr/bin/plutil -lint "$tmpfile" 1>/dev/null

# Import into the {{ .app }} domain (writes to ~/Library/Preferences)
/usr/bin/defaults import {{ .domain }} "$tmpfile"

echo "Imported {{ .domain }} settings via defaults import."
